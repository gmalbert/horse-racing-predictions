# The Racing API Credentials
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git

RACING_API_USERNAME=your_username_here
RACING_API_PASSWORD=your_password_here

# The Odds API Credentials
# API Key from https://the-odds-api.com/
# Limited to 500 calls per month - No historical data available
ODDS_API_KEY=your_api_key_here

# Optional: Set the app timezone used to determine "today" and "tomorrow".
# Use a valid IANA timezone string (e.g., Europe/London, Europe/Dublin, America/New_York).
# If set here, the app will load it from `.env` and apply it automatically.
#APP_TIMEZONE=Europe/London

# ─── Betfair Exchange API (Option E — US Odds) ─────────────────────────────
# Sign up at https://developer.betfair.com/ to obtain an App Key.
# No SSL certificates required for non-interactive login.
# NOTE: Betfair Exchange is geo-restricted — available to UK/Ireland/EU users
# only. US residents cannot access it; the US markets are tradeable from the UK.
#
# BETFAIR_USERNAME=your@email.com
# BETFAIR_PASSWORD=your_betfair_password
# BETFAIR_APP_KEY=your_app_key

# ─── OddsPortal (Option C — multi-bookmaker odds, no credentials required) ──
# No API key needed — scraped via Playwright (headless Chromium).
# Coverage: major US stakes only (Triple Crown, Breeders' Cup, Graded stakes).
# Update KNOWN_US_RACES in scripts/fetch_oddsportal_us.py each season.


# === Equibase Chart Parser (Option B - US Historical Race Results) ===
# Equibase result chart PDFs require a logged-in Equibase session.
# 1. Register for a FREE account at https://www.equibase.com/
# 2. Log in via your browser and open the Developer Tools (F12)
# 3. Go to Application > Cookies > www.equibase.com
# 4. Copy the values of EQBSSO and JSESSIONID cookies
# 5. Paste them below in the format shown:
#
# EQUIBASE_COOKIE=EQBSSO=abc123xyz; JSESSIONID=ABCDEF1234567890
#
# Without this, --parse-only still works for locally saved PDFs.
# PYTHONIOENCODING=utf-8 is recommended on Windows for clean log output.

# === Morning Email Configuration ===
# Configure SMTP settings to receive daily best bets emails
# For Gmail: use app-specific password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
#
# EMAIL_SENDER=your.email@gmail.com
# EMAIL_RECIPIENT=recipient@email.com
# EMAIL_PASSWORD=your_app_specific_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
